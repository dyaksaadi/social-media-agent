# App Setup
NEXT_PUBLIC_APP_URL=http://localhost:3000

# OpenAI (powers the four AI agents via the OpenAI Agents SDK)
# Server-only — never expose with a NEXT_PUBLIC_ prefix.
OPENAI_API_KEY=sk-your_openai_api_key_here
# Optional overrides (defaults shown)
# OPENAI_MODEL=gpt-6-astra
# OPENAI_BASE_URL=https://api.openai.com/v1
#
# No OpenAI billing? Use a free OpenAI-compatible provider instead, e.g. Groq:
#   OPENAI_API_KEY=gsk_...
#   OPENAI_BASE_URL=https://api.groq.com/openai/v1
#   OPENAI_MODEL=llama-3.3-70b-versatile
#   OPENAI_API_MODE=chat_completions
# (Free-tier providers speak Chat Completions, not the Responses API.)

# PostgreSQL Database (Drizzle ORM)
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/your_database

# Inngest Background Jobs & Cron Scheduler
# Local Dev: Run `npm run inngest:dev` (no keys required locally)
# Production: Set Event Key & Signing Key from Inngest Dashboard (https://app.inngest.com)
INNGEST_EVENT_KEY=your_inngest_event_key_here
INNGEST_SIGNING_KEY=your_inngest_signing_key_here
