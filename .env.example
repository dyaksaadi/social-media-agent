# App Setup
NEXT_PUBLIC_APP_URL=http://localhost:3000

# OpenCode inference (powers the four AI agents via the OpenAI Agents SDK over
# OpenCode's OpenAI-compatible chat completions endpoint)
# Server-only — never expose with a NEXT_PUBLIC_ prefix.
OPENCODE_API_KEY=your_opencode_api_key_here
# Optional overrides (defaults shown)
# OPENCODE_MODEL=glm-5.3
# OPENCODE_API_URL=https://opencode.ai/inference/openai/v1
# OPENCODE_API_MODE=chat_completions
#
# You can still point at any OpenAI-compatible provider by setting the
# OPENAI_* variables instead (OPENAI_API_KEY, OPENAI_BASE_URL, OPENAI_MODEL).

# PostgreSQL Database (Drizzle ORM)
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/your_database

# Inngest Background Jobs & Cron Scheduler
# Local Dev: Run `npm run inngest:dev` (no keys required locally)
# Production: Set Event Key & Signing Key from Inngest Dashboard (https://app.inngest.com)
INNGEST_EVENT_KEY=your_inngest_event_key_here
INNGEST_SIGNING_KEY=your_inngest_signing_key_here
